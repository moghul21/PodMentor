APP_NAME=podmentor
ENVIRONMENT=local

# Google Gemini API Key
# Leave empty for offline/mock development mode; set to your API key when available.
GEMINI_API_KEY=

# LLM Model Routing Configuration
PRIMARY_MODEL=gemini-1.5-flash
FALLBACK_MODEL=gemini-1.5-flash-8b
LLM_TIMEOUT_SECONDS=15.0
LLM_MAX_RETRIES=2

# Database Configuration
DATABASE_PATH=podmentor.db
# DATABASE_URL=postgresql://podmentor:podmentor_secret@localhost:5432/podmentor